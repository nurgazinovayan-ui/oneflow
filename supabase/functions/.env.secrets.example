# Edge Function secrets — names only, NO real values. Set the real ones in
# Supabase Dashboard → Edge Functions → Secrets (or `supabase secrets set --env-file <file>` from a
# file that never enters git). See docs/security/deployment.md, step 7.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform: do not set them here.

# --- AI providers (paid) ---
OPENROUTER_API_KEY=
REPLICATE_API_KEY=
OPENAI_API_KEY=
# optional model overrides for marketing-ai
OPENAI_MODEL_LOW=
OPENAI_MODEL_MEDIUM=
OPENAI_MODEL_HIGH=
OPENAI_MODEL_MULTIMODAL=
APIFY_API_TOKEN=

# --- payments ---
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- admin access ---
# comma separated e-mails of administrators
ADMIN_EMAILS=
# 1 = admin functions require an MFA (aal2) session; set only after TOTP is enrolled (deployment.md, step 6)
ADMIN_REQUIRE_MFA=

# --- abuse protection ---
# long random string; salts the client IP hash used by the per-IP rate limit
IP_HASH_SALT=
# optional https:// webhook (Slack / Telegram relay) for spend alerts; gets no user data
ALERT_WEBHOOK_URL=
# long random string; header x-cron-secret of the trendswatch-refresh schedule
CRON_SECRET=

# --- video job timing (optional, milliseconds; defaults 100000 / 25000 / 5000) ---
VIDEO_SYNC_WAIT_MS=
VIDEO_RESUME_WAIT_MS=
VIDEO_POLL_INTERVAL_MS=

# --- integrations ---
GIPHY_API_KEY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# encrypts stored Yandex tokens: changing it invalidates every saved connection (incident-response.md, section 4)
YANDEX_TOKEN_ENCRYPTION_KEY=
