{
  "name": "node-ai-studio",
  "version": "0.1.0",
  "description": "Node-based desktop aggregator for AI image and video generation",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"npm:dev:vite\" \"npm run wait-and-electron\"",
    "wait-and-electron": "wait-on tcp:5173 && npm run dev:electron",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:web": "tsc -p tsconfig.json && vite build --mode web",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.copyFileSync('electron/splash.html','dist-electron/splash.html'); fs.cpSync('electron/presets','dist-electron/presets',{recursive:true}); fs.cpSync('electron/assets','dist-electron/assets',{recursive:true});\"",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.4.5",
    "@astryxdesign/core": "^0.4.5",
    "@astryxdesign/theme-neutral": "^0.4.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "@use-gesture/react": "^10.3.1",
    "@xyflow/react": "^12.3.6",
    "ag-psd": "^31.0.2",
    "docx": "^9.7.1",
    "electron-store": "^8.2.0",
    "lottie-web": "^5.13.0",
    "ogl": "^1.0.11",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicate": "^1.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.oneflow.app",
    "productName": "ONEFLOW",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ONEFLOW-portable.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "@astryxdesign/cli@0.4.5": true,
    "@astryxdesign/core@0.4.5": true
  }
}
