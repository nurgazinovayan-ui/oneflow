#!/usr/bin/env bash
# ONEFLOW — encrypted off-site backup of the KZ server (restic → S3-compatible storage).
#
#   oneflow-backup run      back up now (the systemd timer runs this every night)
#   oneflow-backup status   last successful backup and the latest snapshots
#   oneflow-backup check    verify the repository and re-read 10% of the stored data (weekly timer)
#   oneflow-backup fetch <empty-dir>   restore the latest snapshot into a directory (for recovery)
#   oneflow-backup restore-test        drill: restore the latest dump into a throwaway copy of the db
#                                      container (no network, own storage) and compare the counts
#
# What goes in: a full database dump (all roles and databases, taken inside the db container with
# its own pg_dumpall, so the dump matches the server version), Storage files, the functions and the
# configuration (.env with the server keys, functions.env, compose files, Caddyfile, mail templates).
# restic encrypts everything on this server before upload; the storage provider sees ciphertext only.
# Settings: /etc/oneflow-backup/env and /etc/oneflow-backup/restic-password (both 600 root).
# On failure: a message without data or secrets goes to ALERT_WEBHOOK_URL from functions.env.

set -Eeuo pipefail

CONF_DIR="${CONF_DIR:-/etc/oneflow-backup}"
APP_DIR="${APP_DIR:-/opt/oneflow/supabase}"
STAGE="${STAGE:-/var/backups/oneflow}"
STATE="${STATE:-/var/lib/oneflow-backup}"
DB_CONTAINER="${DB_CONTAINER:-supabase-db}"
KEEP=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)

umask 077

say() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

unquote() { local v=$1; v=${v#\'}; printf '%s' "${v%\'}"; }
env_value() {  # file key
  unquote "$(grep -E "^$2=" "$1" 2>/dev/null | tail -n1 | cut -d= -f2-)"
}

load_conf() {
  [[ -r "$CONF_DIR/env" && -r "$CONF_DIR/restic-password" ]] \
    || { echo "Нет настроек в $CONF_DIR — сначала выполните install-backup.sh" >&2; exit 1; }
  set -a
  # shellcheck source=/dev/null
  source "$CONF_DIR/env"
  set +a
  export RESTIC_PASSWORD_FILE="$CONF_DIR/restic-password"
}

# POST {"text": …} like the functions' spend alerts; the URL (it may carry a token) goes to curl
# through a config file descriptor, not argv
alert() {
  local url text
  url=$(env_value "$APP_DIR/functions.env" ALERT_WEBHOOK_URL)
  [[ "$url" == https://* ]] || return 0
  text=$(python3 -c 'import json, sys; print(json.dumps({"text": sys.argv[1]}))' "$1")
  curl -fsS -m 15 -K <(printf 'url = "%s"\n' "$url") -H 'Content-Type: application/json' \
    --data @- >/dev/null 2>&1 <<< "$text" || true
}

fail() {
  say "ОШИБКА: $1" >&2
  rm -f "$STAGE/db.sql.zst"
  alert "ONEFLOW backup FAILED on $(hostname): $1"
  exit 1
}

backup_paths() {
  local p
  BACKUP_PATHS=("$STAGE/db.sql.zst")
  for p in "$APP_DIR/volumes/storage" "$APP_DIR/volumes/functions" "$APP_DIR/.env" "$APP_DIR/functions.env" \
           "$APP_DIR"/docker-compose*.yml /etc/caddy/Caddyfile /srv/oneflow-mail-templates; do
    [[ -e "$p" ]] && BACKUP_PATHS+=("$p")
  done
  return 0
}

run() {
  load_conf
  exec 9>/run/oneflow-backup.lock
  flock -n 9 || { say "Копирование уже идёт"; exit 0; }
  trap 'fail "строка $LINENO"' ERR
  trap 'fail "прервано"' INT TERM
  install -d -m 700 "$STAGE" "$STATE"
  local started users dump_users snap size
  started=$(date +%s)

  # the dump runs inside the db container (its pg_dumpall matches the server version); the password
  # is handed over by name (-e PGPASSWORD), so it is not on any command line
  PGPASSWORD=$(env_value "$APP_DIR/.env" POSTGRES_PASSWORD)
  export PGPASSWORD
  users=$(docker exec -e PGPASSWORD "$DB_CONTAINER" psql -U supabase_admin -h 127.0.0.1 -d postgres -XAt \
    -c "select count(*) from auth.users") || fail "база не отвечает (контейнер $DB_CONTAINER)"
  [[ "$users" =~ ^[0-9]+$ ]] || fail "не удалось посчитать пользователей"
  if ! docker exec -e PGPASSWORD "$DB_CONTAINER" pg_dumpall -U supabase_admin -h 127.0.0.1 \
      | zstd -q -T0 -f -o "$STAGE/db.sql.zst"; then
    fail "выгрузка базы (pg_dumpall) не удалась"
  fi
  unset PGPASSWORD

  # a dump is only kept when it is complete and holds at least the users counted just before it.
  # One awk pass reads the whole dump: a reader that stops early (grep -q, awk exit) would make
  # zstd die of SIGPIPE on a real-sized dump, and pipefail would report that as a failure.
  local footer
  zstd -tq "$STAGE/db.sql.zst" || fail "архив дампа повреждён"
  read -r dump_users footer < <(zstd -dc "$STAGE/db.sql.zst" | awk '
    /^COPY auth\.users /    { f = 1; next }
    f && /^\\\.$/           { f = 0; if (u == "") u = n + 0; next }
    f                       { n++ }
    /^-- PostgreSQL database cluster dump complete/ { c = 1 }
    END { print (u == "" ? "none" : u), c + 0 }')
  [[ "$footer" == 1 ]] || fail "дамп базы оборван"
  [[ "$dump_users" =~ ^[0-9]+$ ]] || fail "в дампе нет таблицы пользователей"
  (( dump_users >= users )) || fail "в дампе $dump_users пользователей, а в базе $users"
  size=$(du -h "$STAGE/db.sql.zst" | cut -f1)

  backup_paths
  restic backup --quiet --tag oneflow --host "$(hostname)" "${BACKUP_PATHS[@]}"
  restic forget --quiet --tag oneflow --host "$(hostname)" "${KEEP[@]}" --prune
  snap=$(restic snapshots --tag oneflow --host "$(hostname)" --latest 1 --json \
    | python3 -c 'import json, sys; s = json.load(sys.stdin); print(s[-1]["short_id"] if s else "")')
  [[ -n "$snap" ]] || fail "копия не появилась в хранилище"
  rm -f "$STAGE/db.sql.zst"
  printf '%s  копия %s  пользователей %s  дамп базы %s  заняло %s с\n' \
    "$(date '+%F %T %Z')" "$snap" "$users" "$size" "$(( $(date +%s) - started ))" > "$STATE/last-ok"
  say "Готово: $(cat "$STATE/last-ok")"
}

check() {
  load_conf
  trap 'fail "проверка: строка $LINENO"' ERR
  restic check --read-data-subset=10% >/dev/null 2>&1 || fail "проверка хранилища копий не прошла (restic check)"
  # a nightly run that silently stopped is an incident too
  local last; last=$(stat -c %Y "$STATE/last-ok" 2>/dev/null || echo 0)
  (( $(date +%s) - last < 2 * 86400 )) || fail "последняя удачная копия старше 2 суток"
  say "Проверка пройдена: хранилище цело, 10% данных перечитано, последняя копия свежая"
}

# Restore drill, done the way a real recovery is: the dump goes into an EMPTY cluster, so every
# role, schema (auth and storage included, with the columns of this Auth/Storage version) and row
# comes from the backup itself. The throwaway database uses the live db container's image, command
# and environment (read with docker inspect) but none of its init scripts, its own temporary
# storage, no network and another name; the live database is never touched. Users, files and app
# tables are then counted against the dump. A few "already exists" errors are expected (the
# bootstrap superuser exists before the dump creates it).
restore_test() {
  load_conf
  local cname=oneflow-restore-test tmp dump expect_users expect_objects expect_tables
  local got_users got_objects got_tables errors i
  tmp=$(mktemp -d /var/tmp/oneflow-restore.XXXXXX)
  # shellcheck disable=SC2064
  trap "docker rm -f -v $cname >/dev/null 2>&1 || true; rm -rf '$tmp'" EXIT
  docker rm -f -v "$cname" >/dev/null 2>&1 || true

  say "Достаю последнюю копию базы из хранилища…"
  restic restore latest --tag oneflow --target "$tmp/r" --include "$STAGE/db.sql.zst" >/dev/null
  dump="$tmp/r$STAGE/db.sql.zst"
  [[ -s "$dump" ]] || { echo "В последней копии нет дампа базы" >&2; exit 1; }
  read -r expect_users expect_objects expect_tables < <(zstd -dc "$dump" | awk '
    /^COPY auth\.users /      { blk = "u"; next }
    /^COPY storage\.objects / { blk = "o"; next }
    blk != "" && /^\\\.$/      { blk = ""; next }
    blk == "u" { u++ } blk == "o" { o++ }
    /^CREATE TABLE public\./  { t++ }
    END { print u + 0, o + 0, t + 0 }')

  say "Запускаю временную копию контейнера базы (без сети)…"
  # docker run arguments from the live container; its environment (with the database password)
  # goes through an env file in the private temp dir, never through argv
  python3 - "$DB_CONTAINER" "$tmp" <<'PY'
import json, subprocess, sys
name, tmp = sys.argv[1], sys.argv[2]
c = json.loads(subprocess.check_output(["docker", "inspect", name]))[0]
import os
with open(f"{tmp}/env", "w") as f:
    for e in c["Config"].get("Env") or []:
        if "\n" not in e and not e.startswith("POSTGRES_USER="):
            f.write(e + "\n")
    f.write("POSTGRES_USER=supabase_admin\n")  # bootstrap superuser = the role the dump is loaded as
# an empty init dir: none of the image's or compose's init scripts run, the cluster stays empty
os.makedirs(f"{tmp}/initdb", mode=0o755)
os.chmod(f"{tmp}/initdb", 0o755)
args = ["--env-file", f"{tmp}/env", "-v", f"{tmp}/initdb:/docker-entrypoint-initdb.d:ro"]
for m in c.get("Mounts", []):
    dst = m["Destination"]
    if dst.startswith("/docker-entrypoint-initdb.d"):
        continue                               # init scripts: not for a restore into an empty cluster
    if dst == "/var/lib/postgresql/data" or m.get("Type") == "volume":
        args += ["-v", dst]                    # fresh anonymous volume, removed with the container
    elif m.get("Type") == "bind":
        args += ["-v", f"{m['Source']}:{dst}:ro"]
args.append(c["Config"]["Image"])
args += c["Config"].get("Cmd") or []
with open(f"{tmp}/args", "wb") as f:
    f.write(b"\0".join(a.encode() for a in args))
PY
  local -a run_args
  mapfile -d '' run_args < "$tmp/args"
  docker run -d --name "$cname" --network none "${run_args[@]}" >/dev/null

  # ready = the init scripts finished and the server listens on TCP (during init it does not)
  for i in $(seq 1 120); do
    if docker exec "$cname" pg_isready -U postgres -h localhost >/dev/null 2>&1; then break; fi
    (( i == 120 )) && { docker logs --tail 15 "$cname" 2>&1 | sed 's/^/    /'; echo "Временная база не запустилась за 10 минут" >&2; exit 1; }
    sleep 5
  done
  sleep 5

  say "Загружаю дамп во временную базу…"
  PGPASSWORD=$(env_value "$APP_DIR/.env" POSTGRES_PASSWORD)
  export PGPASSWORD
  zstd -dc "$dump" | docker exec -i -e PGPASSWORD "$cname" \
    psql -U supabase_admin -h localhost -d postgres -X -q -v ON_ERROR_STOP=0 > "$tmp/restore.log" 2>&1 || true
  read -r got_users got_objects got_tables < <(docker exec -e PGPASSWORD "$cname" \
    psql -U supabase_admin -h localhost -d postgres -XAt -F ' ' -c "select
      (select count(*) from auth.users), (select count(*) from storage.objects),
      (select count(*) from pg_tables where schemaname = 'public')" 2>/dev/null || echo "? ? ?")
  unset PGPASSWORD
  errors=$(grep -cE '(^|: )(ERROR|ОШИБКА):' "$tmp/restore.log" || true)

  mark() { [[ "$1" == "$2" ]] && echo "✓" || echo "✗"; }
  echo
  echo "    Пользователи:             в копии $expect_users, восстановлено $got_users $(mark "$expect_users" "$got_users")"
  echo "    Записи файлов хранилища:  в копии $expect_objects, восстановлено $got_objects $(mark "$expect_objects" "$got_objects")"
  echo "    Таблицы приложения:       в копии $expect_tables, восстановлено $got_tables $(mark "$expect_tables" "$got_tables")"
  echo "    Сообщений об ошибках при загрузке: $errors (несколько «уже существует» — нормально)"
  if [[ "$got_users" == "$expect_users" && "$got_objects" == "$expect_objects" && "$got_tables" == "$expect_tables" ]]; then
    say "Учебное восстановление прошло: из копии поднимаются все пользователи, записи файлов и таблицы"
  else
    echo "    Чаще всего встречались (без данных пользователей):"
    grep -oE '(ERROR|ОШИБКА): +[^"]*' "$tmp/restore.log" | sort | uniq -c | sort -rn | head -5 | sed 's/^/      /'
    fail "учебное восстановление: числа не совпали"
  fi
}

status() {
  load_conf
  echo "Последняя удачная копия:"
  echo "  $(cat "$STATE/last-ok" 2>/dev/null || echo 'ещё не было')"
  echo
  restic snapshots --tag oneflow --compact --latest 7
  echo
  systemctl list-timers 'oneflow-backup*' --no-pager 2>/dev/null || true
}

fetch() {
  local dir=${1:?укажите пустую папку: oneflow-backup fetch /root/restore}
  load_conf
  [[ ! -e "$dir" || -z "$(ls -A "$dir")" ]] || { echo "Папка $dir не пустая" >&2; exit 1; }
  install -d -m 700 "$dir"
  restic restore latest --tag oneflow --target "$dir"
  echo "Восстановлено в $dir (дамп базы: $dir$STAGE/db.sql.zst)"
}

case "${1:-}" in
  run) run ;;
  check) check ;;
  status) status ;;
  fetch) fetch "${2:-}" ;;
  restore-test) restore_test ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
