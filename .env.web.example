# Copy this to .env.web (gitignored) before running `npm run build:web` or the web dev server.
# These are all publishable/public-facing values by design (Supabase anon key, Yandex OAuth
# client id, LemonSqueezy storefront link) — they end up baked into the client JS bundle on
# every build anyway, so there's nothing sensitive to protect here. The real secret
# (Yandex client_secret) lives only in the Supabase Edge Function env, never in this file.

VITE_WEB_MODE=1
VITE_SUPABASE_URL=https://ayxmfihtrsacfdhszsri.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xfd5nkUu18qvdzoo-dzhHQ_f5RKq4tS
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://oneflow.lemonsqueezy.com/checkout/buy/2b5b7ba4-fe7f-461b-a989-7abd68c3c8dd
VITE_YANDEX_CLIENT_ID=170f154c066f45138ed1ff22fc0a5f86

# Product analytics (PostHog). Leave both unset to ship without analytics: every capture() call
# becomes a no-op and the consent banner doesn't render at all. The project key is publishable
# like the values above — PostHog keys are meant to be in client code.
# Host picks the data region: https://eu.i.posthog.com (default, EU) or https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Production domain, e.g. https://oneflow.kz — used at BUILD TIME only (never sent to the
# client). With it set, the build emits sitemap.xml, adds the Sitemap line to robots.txt and
# turns og:image/og:url into absolute URLs. Left empty, none of that is emitted: a sitemap
# pointing at the wrong domain is worse than no sitemap, so nothing here guesses one.
VITE_SITE_URL=
